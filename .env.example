# Copy to .env.local and adjust. All values are optional — defaults target the live backend.

# Backend REST API base URL (TeacherCenters API). A bare domain gets /api/v1 appended.
NEXT_PUBLIC_API_URL=https://teachercenter.runasp.net/api/v1

# Public URL of this frontend (metadataBase / Open Graph / sitemap).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: address the Next.js server (BFF /api/v1/auth/*) uses to reach the backend.
# API_URL_INTERNAL=http://api.internal:8080/api/v1

# Playwright e2e only (never commit real values): a test account on the backend.
# E2E_TENANT=
# E2E_PHONE=
# E2E_PASSWORD=
