# Copy to .env.local and adjust.

# Backend REST API base URL incl. version prefix (all RTK Query endpoints are relative to this).
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1

# Public URL of this frontend (metadataBase / Open Graph / sitemap).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: address the Next.js server (BFF /api/auth/*) uses to reach the backend, e.g. a private
# network URL. Defaults to NEXT_PUBLIC_API_URL.
# API_URL_INTERNAL=http://api.internal:8080/api/v1

# Dev only: serve the built-in mock backend at /api/mock (see src/mocks/fixtures.ts for demo logins).
# To use it set NEXT_PUBLIC_API_URL=http://localhost:3000/api/mock
API_MOCK=false
